# Gateway internal/platform/config/config.go confirms the default listen address.
# Server only. Use a private trusted network or HTTPS when deployed remotely.
GATEWAY_API_URL=http://127.0.0.1:8080
# Must exceed the Gateway 130s request timeout (detail may refresh an upstream token).
GATEWAY_TIMEOUT_MS=135000
# Optional. Comma-separated host[:port] origins allowed to call Server Actions.
# Needed when the app is accessed by IP or behind a reverse proxy that rewrites
# the Host/Origin headers. Example: 192.168.1.96:3000,admin.example.com
# ALLOWED_ORIGINS=
